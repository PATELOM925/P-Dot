# Copy to .env.local for local development. Never commit real credentials.
# On Cloudflare: NEXT_PUBLIC_* values are inlined at BUILD time, so set them in the
# build environment (Workers Builds → Build variables, or your local shell/.env.local
# when running `npm run deploy`). Everything else is read at RUNTIME: store keys with
# `npx wrangler secret put NAME` and other values as Worker variables in the dashboard.
# WARNING: the OpenNext build copies every value in .env/.env.local into the Worker
# bundle. `npm run deploy` stops if a name that is not on the allow list in
# scripts/worker-env-rules.mjs (for example a key or password) has a value here. See docs/DEPLOYMENT.md.

# --- Supabase (authentication + database) -------------------------------
# Project URL and *publishable* key (Project Settings → API Keys). These are
# public by design; data is protected by row-level security. Do NOT put the
# secret/service-role key anywhere in this app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public base URL used in verification and password-reset emails.
# Set this to your deployed origin (production: https://pdot.iampatelom.com) in production;
# it defaults to http://localhost:3000, which would put localhost links in real emails.
# Every URL used here must be in Supabase Auth → URL Configuration → Redirect URLs.
SITE_URL=

# --- Nebius Token Factory (inference) — server-only ----------------------
# Never prefix these with NEXT_PUBLIC_.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Model routing (docs/decisions/0007-model-routing.md). Each tier tries its models in
# order. Comma-separated, 1 to 4 model IDs. Every model must have a price in
# src/server/providers/nebius/pricing.ts, or chat says "not configured".
# Leave a line empty to use the default shown. NEBIUS_MODEL is no longer read.
NEBIUS_FAST_MODELS=nvidia/Nemotron-3_5-Lightning,nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B,nvidia/nemotron-3-super-120b-a12b
NEBIUS_STANDARD_MODELS=nvidia/nemotron-3-super-120b-a12b,nvidia/Nemotron-3_5-Lightning
NEBIUS_HEAVY_MODELS=nvidia/Nemotron-3-Ultra-550b-a55b,nvidia/nemotron-3-super-120b-a12b
NEBIUS_VISION_MODELS=nvidia/Nemotron-3.5-Super-VL
# Maximum tokens per reply (64–8192): fast and vision, standard, heavy.
NEBIUS_MAX_OUTPUT_TOKENS=1024
NEBIUS_STANDARD_MAX_OUTPUT_TOKENS=2048
NEBIUS_HEAVY_MAX_OUTPUT_TOKENS=4096
# Reasoning tokens for the heavy tier (0 turns reasoning off). It must leave at
# least 512 tokens of NEBIUS_HEAVY_MAX_OUTPUT_TOKENS for the reply.
NEBIUS_HEAVY_THINKING_BUDGET=1024
# Fast tier only: start one parallel request on the next model when no token
# has come after this many milliseconds (0 turns it off).
NEBIUS_HEDGE_AFTER_MS=1500

# --- Tavily (optional web search) — server-only --------------------------
# Leave empty to disable; search requests will then report that search failed.
TAVILY_API_KEY=

# --- Google (optional; docs/decisions/0014-google-sign-in-and-connection.md) ---
# Connect Google on the Connectors page. Leave all three empty and Google shows
# "Not set up". Sign-in with Google does not use these: it uses the Supabase
# Google provider. Only GOOGLE_OAUTH_CLIENT_ID is on the bundle allow list;
# remove the other two from .env.local before a manual deploy.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 32 random bytes, base64: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=

# --- MCP connectors (optional; docs/decisions/0016-mcp-connectors.md) -------
# Seals the Notion, Linear, Todoist and GitHub tokens and the Telegram link.
# 32 random bytes, base64: openssl rand -base64 32
CONNECTOR_TOKEN_ENCRYPTION_KEY=

# --- GitHub (optional; docs/decisions/0020-connectors-v2.md) ----------------
# A GitHub App with read-only permissions. Leave both empty and GitHub stays
# under "Coming soon". Callback URL: <SITE_URL>/api/connectors/mcp/callback
GITHUB_MCP_CLIENT_ID=
GITHUB_MCP_CLIENT_SECRET=

# --- Telegram (optional; docs/decisions/0020-connectors-v2.md) --------------
# One bot from @BotFather. Leave all three empty and Telegram stays under
# "Coming soon". Also needs CONNECTOR_TOKEN_ENCRYPTION_KEY.
TELEGRAM_BOT_TOKEN=
# The bot's username, without "@". It must end in "bot".
TELEGRAM_BOT_USERNAME=
# 32 to 256 of A-Z a-z 0-9 _ -. Give the same value to setWebhook as secret_token.
TELEGRAM_WEBHOOK_SECRET=

# --- Usage limits ---------------------------------------------------------
# Per-user chat requests allowed per fixed window (enforced in Postgres).
CHAT_REQUESTS_PER_WINDOW=30
CHAT_WINDOW_SECONDS=3600

# --- Global spend caps (all users together; enforced in Postgres) ----------
# See docs/decisions/0006-global-spend-guard.md. Days and months are UTC.
# Nebius cost in US dollars: per day, all time, and per user per day (max 0.50).
NEBIUS_DAILY_CAP_USD=1.00
NEBIUS_TOTAL_CAP_USD=20.00
NEBIUS_USER_DAILY_CAP_USD=0.25
# Tavily credits (a basic search is 1 credit): per day, per month, and per user per day (max 20).
TAVILY_DAILY_CREDITS=40
TAVILY_MONTHLY_CREDITS=800
TAVILY_USER_DAILY_CREDITS=10

# --- Local simulation (no keys, no cost) --------------------------------------
# `npm run mock:providers` starts a fake Nebius + Tavily on http://127.0.0.1:4010.
# Its replies are rule-based and labelled "Simulated reply". To use it, set:
#   NEBIUS_API_KEY=local-mock-key
#   NEBIUS_BASE_URL=http://127.0.0.1:4010/v1
#   TAVILY_API_KEY=local-mock-key
#   TAVILY_BASE_URL=http://127.0.0.1:4010/tavily
# For the real services, use your real keys, keep the default NEBIUS_BASE_URL and
# leave TAVILY_BASE_URL empty (it only accepts https, or http to this machine).
TAVILY_BASE_URL=
