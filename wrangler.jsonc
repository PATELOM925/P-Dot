{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pdot",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "pdot"
    }
  ],
  // Served only on the custom domain; the workers.dev address is turned off.
  "routes": [{ "pattern": "pdot.iampatelom.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // Non-secret runtime settings. Secrets (NEBIUS_API_KEY, TAVILY_API_KEY)
  // are set with `npx wrangler secret put` and never stored here.
  "vars": {
    "SITE_URL": "https://pdot.iampatelom.com"
  },
  "observability": {
    "enabled": true
  }
}
