{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pdot",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "pdot"
    }
  ],
  // Production is served only on the custom domain; its workers.dev address is off.
  "routes": [{ "pattern": "pdot.iampatelom.com", "custom_domain": true }],
  "workers_dev": false,
  // Pull request Previews and version links use workers.dev. See docs/DEPLOYMENT.md.
  "preview_urls": true,
  // Non-secret runtime settings. Secrets (NEBIUS_API_KEY, TAVILY_API_KEY)
  // are set with `npx wrangler secret put` and never stored here.
  "vars": {
    "SITE_URL": "https://pdot.iampatelom.com"
  },
  // Keep variables set in the dashboard (for example NEBIUS_MODEL) when a deploy runs.
  "keep_vars": true,
  // Settings for `wrangler preview` (pull request branches). The block is required.
  // Previews use their own secrets (Preview base config), not the production secrets.
  "previews": {
    "vars": {
      "SITE_URL": "https://pdot.iampatelom.com"
    }
  },
  "observability": {
    "enabled": true
  }
}
